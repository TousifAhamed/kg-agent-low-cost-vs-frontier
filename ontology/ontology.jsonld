{
  "@context": {
    "@version": 1.1,
    "cew1": "https://cew1.example.org/ontology/v1#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "prov": "http://www.w3.org/ns/prov#",
    "qudt": "http://qudt.org/schema/qudt/",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "domain": {"@id": "rdfs:domain", "@type": "@id"},
    "range": {"@id": "rdfs:range", "@type": "@id"},
    "subClassOf": {"@id": "rdfs:subClassOf", "@type": "@id"}
  },
  "@id": "https://cew1.example.org/ontology/v1",
  "@type": "owl:Ontology",
  "owl:versionInfo": "1.0.0",
  "rdfs:comment": "Minimum-viable ontology (RQ1) unifying the Well Connectivity Dashboard and Water Management Analytics tool for a KG-grounded LLM agent. Aligned to an ISO 15926 / RDL minimal subset in spirit; every instance node/edge carries a PROV provenance back-pointer (prov:wasDerivedFrom -> source dashboard record id + timestamp). Cost-bearing edges (RECOMMENDED_FOR) are separable for the RQ1 flat-vs-relational-with-cost ablation.",
  "@graph": [

    {"@id": "cew1:Field", "@type": "owl:Class", "label": "Field",
     "comment": "A producing petroleum field (e.g., Volve). Top of the asset hierarchy: Field > Reservoir > Well."},
    {"@id": "cew1:Reservoir", "@type": "owl:Class", "label": "Reservoir",
     "comment": "A reservoir compartment within a Field."},
    {"@id": "cew1:Well", "@type": "owl:Class", "label": "Well",
     "comment": "A wellbore. wellType in {producer, injector} distinguishes roles for connectivity edges.",
     "cew1:hasAttribute": ["wellId", "wellName", "wellType", "onstreamDate"]},
    {"@id": "cew1:Sensor", "@type": "owl:Class", "label": "Sensor",
     "comment": "A logical sensor/channel on a Well emitting one metric family (pressure, rate, water-cut).",
     "cew1:hasAttribute": ["sensorId", "metricType", "unit"]},
    {"@id": "cew1:MetricReading", "@type": "owl:Class", "label": "MetricReading",
     "comment": "A timestamped scalar reading (or derived diagnostic: water-cut, log(WOR), Np, connectivity score).",
     "cew1:hasAttribute": ["readingId", "timestamp", "metricType", "value", "unit"]},
    {"@id": "cew1:Alert", "@type": "owl:Class", "label": "Alert",
     "comment": "A rule-based event raised from readings (e.g., water breakthrough on the log(WOR) vs Np plot).",
     "cew1:hasAttribute": ["alertId", "alertCode", "severity", "raisedAt"]},
    {"@id": "cew1:Intervention", "@type": "owl:Class", "label": "Intervention",
     "comment": "A recommended or executed remedial action (e.g., water shutoff, rate change) with a cost-per-barrel outcome.",
     "cew1:hasAttribute": ["interventionId", "actionType", "estCostPerBbl", "expectedUpliftBbl", "status"]},

    {"@id": "cew1:INJECTS_INTO", "@type": "owl:ObjectProperty", "label": "INJECTS_INTO",
     "domain": "cew1:Well", "range": "cew1:Well",
     "comment": "Injector -> Producer connectivity edge; carries a CRM-derived connectivity weight in {0..1} and a noise sigma. This edge is the Well Connectivity Dashboard's core output."},
    {"@id": "cew1:PRODUCES_FROM", "@type": "owl:ObjectProperty", "label": "PRODUCES_FROM",
     "domain": "cew1:Well", "range": "cew1:Reservoir",
     "comment": "Producer Well -> Reservoir it draws from."},
    {"@id": "cew1:MEASURED_BY", "@type": "owl:ObjectProperty", "label": "MEASURED_BY",
     "domain": "cew1:MetricReading", "range": "cew1:Sensor",
     "comment": "Reading -> Sensor that produced it (Sensor -> Well via cew1:onWell)."},
    {"@id": "cew1:TRIGGERED_BY", "@type": "owl:ObjectProperty", "label": "TRIGGERED_BY",
     "domain": "cew1:Alert", "range": "cew1:MetricReading",
     "comment": "Alert -> the reading(s) whose rule threshold fired it. Backbone of the alert->root-cause explanation trace."},
    {"@id": "cew1:RECOMMENDED_FOR", "@type": "owl:ObjectProperty", "label": "RECOMMENDED_FOR",
     "domain": "cew1:Intervention", "range": "cew1:Alert",
     "comment": "Intervention -> Alert it addresses. COST-BEARING edge: estCostPerBbl / expectedUpliftBbl live here. Removed in the RQ1 flat-schema ablation, present in relational-schema-with-cost-edges."},
    {"@id": "cew1:FOLLOWED_BY", "@type": "owl:ObjectProperty", "label": "FOLLOWED_BY",
     "domain": "cew1:Intervention", "range": "cew1:MetricReading",
     "comment": "Intervention -> post-action readings that measure its realized outcome (uplift / water-cut delta)."},

    {"@id": "cew1:onWell", "@type": "owl:ObjectProperty", "label": "onWell",
     "domain": "cew1:Sensor", "range": "cew1:Well", "comment": "Sensor -> Well it is mounted on."},
    {"@id": "cew1:inField", "@type": "owl:ObjectProperty", "label": "inField",
     "domain": "cew1:Reservoir", "range": "cew1:Field", "comment": "Reservoir -> containing Field."},

    {"@id": "cew1:wasDerivedFrom", "@type": "owl:AnnotationProperty",
     "subClassOf": "prov:wasDerivedFrom", "label": "wasDerivedFrom",
     "comment": "REQUIRED on every instance node and edge: {sourceRecordId, sourceDashboard, timestamp, generatorSeed}. Enables the citation-validation guardrail (M3) and hallucination-rate metric."}
  ]
}
